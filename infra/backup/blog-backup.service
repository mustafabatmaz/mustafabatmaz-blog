# Runs the nightly backup; started by blog-backup.timer. Installed with:
#   sudo cp infra/backup/blog-backup.service infra/backup/blog-backup.timer /etc/systemd/system/
# The paths below assume the repository at /home/mustafa/mustafabatmaz-blog.
[Unit]
Description=Back up mustafabatmaz.com (database and images) to Backblaze B2
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=mustafa
Environment=HOME=/home/mustafa
ExecStart=/home/mustafa/mustafabatmaz-blog/infra/backup/backup.sh
