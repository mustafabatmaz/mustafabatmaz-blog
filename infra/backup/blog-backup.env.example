# Copy to ~/.config/blog-backup.env on the server and fill in; chmod 600. Never commit the real file.
# Plain KEY=value lines without quotes: Docker reads this file too (docker run --env-file), and it takes quotes
# literally.

# restic's repository in Backblaze B2, through its S3-compatible API: s3:https://<endpoint>/<bucket>
RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/mustafabatmaz-blog-backups
# Encrypts every backup. Lose it and the backups can't be read: keep it in the password manager.
# Generate with: openssl rand -base64 32
RESTIC_PASSWORD=

# The B2 application key limited to that bucket (keyID and applicationKey)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# healthchecks.io ping URL of the backup check; empty switches the pings off
HEALTHCHECK_URL=
