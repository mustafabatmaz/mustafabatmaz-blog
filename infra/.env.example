# Copy to infra/.env and change the values. infra/.env is gitignored.
DB_NAME=blog
DB_USER=blog
DB_PASSWORD=change-me

# Admin login for the back-office
ADMIN_USERNAME=admin
# BCrypt hash of your password (see README). Keep the single quotes:
# without them Compose reads every $ in the hash as a variable.
ADMIN_PASSWORD_HASH='replace-with-bcrypt-hash'
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-random-base64-secret
JWT_TTL=8h

# Local development over plain http; must be true anywhere served over https
COOKIE_SECURE=false
# Swagger UI at http://localhost:8080/swagger-ui.html
API_DOCS_ENABLED=true

# Public site's own address, for OG images, canonical links, the sitemap and RSS (no trailing slash).
# Required in production; next dev falls back to http://localhost:3000.
SITE_URL=http://localhost:3000
